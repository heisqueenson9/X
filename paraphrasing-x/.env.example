# ============================================
# Paraphrasing X — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# MongoDB Connection String
# Get from: https://cloud.mongodb.com (free tier available)
MONGODB_URI=mongodb://localhost:27017/paraphrasing-x

# Paystack Keys
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace API Key (FREE - No Installation Needed)
# 1. Go to https://huggingface.co/settings/tokens
# 2. Create a free account (takes 1 minute)
# 3. Click "New token" 
# 4. Give it a name, select "read" permission
# 5. Copy the token and paste it below
# If left blank, system uses built-in fallback paraphraser (works without any API)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of your deployment (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Alternative HuggingFace models
# HUGGINGFACE_MODEL=facebook/bart-large-cnn (default)
# HUGGINGFACE_MODEL=google/flan-t5-large

# Next.js
NEXTAUTH_SECRET=your-random-secret-here

